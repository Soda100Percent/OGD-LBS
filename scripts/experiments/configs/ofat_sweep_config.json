    "delta_sweeps_by_model": {
        "Griffin_A2": [5.0, 10.0, 15.0, 20.0, 25.0],
        "Winter_Samurai": [0.5, 1.0, 1.5, 2.0, 2.5]
    },
    "data_prep_defaults": {
        "target_frame_count": 200
    },
    "ssdr_defaults": {
        "max_workers": 16,
