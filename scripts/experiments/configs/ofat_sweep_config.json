        "health_level": 1,
        "health_every": 5,
        "health_weight_scheme": "uniform",
        "eval_bone_health": true,
        "bone_health_every": 5,
        "max_workers": 16,
        "validate_output": true,
        "weak_validate": false,
        "save_intermediate": false,
        "freeze_weights": false
