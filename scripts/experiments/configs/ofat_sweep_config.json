    "defaults": {
        "alpha": 0.5,
        "beta": 0.3,
        "gamma": 0.2,
        "s_max": 4,
        "tau": "adaptive",
        "omega_b": 1000.0
    },
    "abc_coupling": {
        "mode": "keep_sum_one",
