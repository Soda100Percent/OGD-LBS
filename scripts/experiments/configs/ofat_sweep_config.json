            "prep02_config": "/workspace/git_projects/OGD-LBS/scripts/data_prep/configs/prep_02_sdf_merge_config_winter_samurai.json",
            "extra_bone_reduce_config": "/workspace/git_projects/OGD-LBS/scripts/data_prep/configs/extra_bone_reduce_winter_samurai.json",
            "qem_config": null,
