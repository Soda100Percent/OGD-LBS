{
  "schema": "ogd_lbs_winter_samurai_final_weapon_config_v1",
  "notes": [
    "Use only after Step 02a with model/rest_pose_base.blend.",
    "Step 01 must keep leaf bones: --no_ignore_leaf_bones.",
    "Virtual mounts only; no additional socket bones.",
    "Weapon becomes a root bone; mesh weights are unchanged.",
    "Right-hand reference: WS_Stance, Blender frame 1.",
    "Back reference: WS_Run2, Blender frame 1.",
    "Walk3 parameters were visually approved before the final full-pipeline regression.",
    "Walk3 offset is relative to the evaluated LeftHand midpoint and expressed as fractions of LeftHand rest length.",
    "This configuration requires 04_fix_weapon_mount_aim.py, not the core script alone."
  ],
  "weapon_bone": "Weapon",
  "weapon_mesh": "Weapon",
  "detach_weapon_bone": {
    "enabled": true,
    "preserve_armature_space_rest_matrix": true,
    "preserve_unconfigured_actions": true
  },
  "mounts": {
    "hand_r": {
      "type": "direct",
      "mount_bone": "Character1_RightHand",
      "reference_action": "WS_Stance",
      "reference_frame": 1
    },
    "back": {
      "type": "direct",
      "mount_bone": "Character1_Spine1",
      "reference_action": "WS_Run2",
      "reference_frame": 1
    }
  },
  "action_policies": {
    "WS_Attack1": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Attack2": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Attack3": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Attack4": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Death": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Death2": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Idle1": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Idle2": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Idle3": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Idle4": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Idle5": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Run1": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Run2": {"enabled": true, "mode": "mount", "mount": "back", "frame_start": null, "frame_end": null},
    "WS_Run3": {"enabled": true, "mode": "mount", "mount": "back", "frame_start": null, "frame_end": null},
    "WS_Stance": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Walk": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Walk2": {"enabled": true, "mode": "mount", "mount": "hand_r", "frame_start": null, "frame_end": null},
    "WS_Walk3": {
      "enabled": true,
      "mode": "mount",
      "mount": "hand_r",
      "frame_start": null,
      "frame_end": null,
      "aim": {
        "axis": "-Y",
        "target_bone": "Character1_LeftHand",
        "target_offset_fraction_of_length": [-0.5, 0.5, 0.0]
